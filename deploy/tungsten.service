[Unit]
Description=Tungsten personal notes
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=tungsten
Environment=SQLITE_TMPDIR=/var/lib/tungsten/notes
ExecStart=/usr/local/bin/tungsten --data-dir /var/lib/tungsten/notes --listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
