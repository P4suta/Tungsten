{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "packageRules": [
    {
      "description": "The pinned prose checker requires Vale 3.25.1.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["vale-cli/vale"],
      "allowedVersions": "3.25.1"
    },
    {
      "matchFileNames": ["Dockerfile"],
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ]
    }
  ]
}
