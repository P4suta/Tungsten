<Page x:Class="Tungsten.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Tungsten.Core" Loaded="PageLoaded">
  <Grid x:Name="Root" KeyDown="RootKeyDown" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ConnectionPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="480" Margin="24" Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <TextBlock x:Uid="ConnectionHeading" Text="Connect to server" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
        <TextBlock x:Uid="ConnectionDescription" Text="Enter the HTTPS address of your Tungsten server." TextWrapping="Wrap"/>
        <TextBox x:Name="ServerAddress" x:Uid="ServerAddress" Header="Server address" PlaceholderText="https://notes.example"
          AutomationProperties.AutomationId="ServerAddress" AutomationProperties.Name="Server address"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Uid="Connect" Content="Connect" Style="{StaticResource AccentButtonStyle}" Click="ConnectClicked" AutomationProperties.AutomationId="Connect"/>
          <Button x:Name="CancelConnection" x:Uid="CancelConnection" Content="Cancel" Click="CancelConnectionClicked" Visibility="Collapsed" AutomationProperties.AutomationId="CancelConnection"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <InfoBar x:Name="Problem" x:Uid="Problem" IsClosable="False" Severity="Error" Title="Writing needs attention"
      AutomationProperties.AutomationId="Problem" AutomationProperties.LiveSetting="Polite">
      <InfoBar.ActionButton>
        <Button x:Uid="Retry" Content="Retry" Click="RetryClicked" AutomationProperties.AutomationId="Retry"/>
      </InfoBar.ActionButton>
    </InfoBar>
    <NavigationView x:Name="Collections" x:Uid="Collections" Grid.Row="1" IsSettingsVisible="True" PaneTitle="Collections" OpenPaneLength="220"
      Loaded="CollectionsLoaded" PaneOpened="CollectionsPaneOpened" SelectionChanged="CollectionChanged" ItemInvoked="CollectionInvoked" DisplayModeChanged="CollectionsDisplayModeChanged"
      BackRequested="BackRequested" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" Visibility="Collapsed"
      AutomationProperties.Name="Collections" AutomationProperties.AutomationId="Collections">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Uid="AllNotes" Content="All notes" Icon="Document" Tag="all" AutomationProperties.AutomationId="AllNotes"/>
        <NavigationViewItem x:Uid="Drafts" Content="Drafts" Icon="Edit" Tag="drafts" AutomationProperties.AutomationId="Drafts"/>
        <NavigationViewItem x:Uid="Trash" Content="Trash" Icon="Delete" Tag="trash" AutomationProperties.AutomationId="Trash"/>
        <NavigationViewItemHeader x:Uid="WorkspaceHeading" Content="Workspaces"/>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Spacing="8" Margin="8">
          <Button x:Uid="CreateWorkspace" Content="Create workspace" IsEnabled="{x:Bind ViewModel.HasConnection, Mode=OneWay}" Click="CreateWorkspaceClicked" AutomationProperties.AutomationId="CreateWorkspace"/>
        </StackPanel>
      </NavigationView.PaneFooter>
      <Grid x:Name="WorkspaceGrid" SizeChanged="WorkspaceSizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NotesColumn" Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="NotesPane" Margin="12,8" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <CommandBar x:Name="NotesHeader" DefaultLabelPosition="Right" HorizontalContentAlignment="Stretch">
            <CommandBar.Content><TextBlock x:Name="CollectionTitle" AutomationProperties.AutomationId="CollectionTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" Margin="0,8"/></CommandBar.Content>
            <AppBarButton x:Uid="NewNote" Icon="Add" Label="New note" IsEnabled="{x:Bind ViewModel.HasConnection, Mode=OneWay}" Click="NewClicked" AutomationProperties.AutomationId="NewNote"/>
            <CommandBar.SecondaryCommands>
              <AppBarButton x:Name="RenameWorkspace" x:Uid="RenameWorkspace" Icon="Rename" Label="Rename workspace" IsEnabled="False" Click="RenameWorkspaceClicked" AutomationProperties.AutomationId="RenameWorkspace"/>
              <AppBarButton x:Name="DeleteWorkspace" x:Uid="DeleteWorkspace" Icon="Delete" Label="Delete workspace" IsEnabled="False" Click="DeleteWorkspaceClicked" AutomationProperties.AutomationId="DeleteWorkspace"/>
            </CommandBar.SecondaryCommands>
          </CommandBar>
          <AutoSuggestBox x:Name="Search" x:Uid="Search" Grid.Row="1" PlaceholderText="Search notes" QueryIcon="Find" QuerySubmitted="SearchSubmitted"
            AutomationProperties.Name="Search notes" AutomationProperties.AutomationId="Search"/>
          <ListView x:Name="NotesList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="NoteClicked"
            AutomationProperties.Name="Notes" AutomationProperties.AutomationId="NotesList" SelectionMode="Single">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="core:Summary">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <SymbolIcon Symbol="Document" VerticalAlignment="Top" Margin="0,8,0,0"/>
                  <StackPanel Grid.Column="1" Margin="0,8" Spacing="4">
                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Snippet, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <ListView x:Name="TrashList" Grid.Row="2" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="TrashClicked"
            AutomationProperties.Name="Deleted notes" AutomationProperties.AutomationId="TrashList">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="core:SavedNote">
              <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <SymbolIcon Symbol="Document"/><TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneTime}" TextWrapping="Wrap"/>
              </Grid>
            </DataTemplate></ListView.ItemTemplate>
          </ListView>
          <StackPanel Grid.Row="3" Spacing="8">
            <Button x:Name="MoreButton" x:Uid="LoadMore" Content="Load more" Click="MoreClicked" Visibility="Collapsed" AutomationProperties.AutomationId="LoadMore"/>
            <Button x:Name="EmptyTrashButton" x:Uid="EmptyTrash" Content="Empty Trash" Click="EmptyTrashClicked" Visibility="Collapsed" AutomationProperties.AutomationId="EmptyTrash"/>
            <TextBlock x:Name="ListStatus" x:Uid="ListStatus" Text="Connect to a server to load notes." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="EditorPane" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <CommandBar x:Name="EditorCommands" DefaultLabelPosition="Right" IsEnabled="{x:Bind ViewModel.HasEditor, Mode=OneWay}">
            <AppBarButton x:Uid="Bold" Icon="Bold" Label="Bold" Click="BoldClicked" AutomationProperties.AutomationId="Bold"/>
            <AppBarButton x:Uid="Italic" Icon="Italic" Label="Italic" Click="ItalicClicked" AutomationProperties.AutomationId="Italic"/>
            <AppBarButton x:Uid="InlineCode" Label="Inline code" Click="CodeClicked" AutomationProperties.AutomationId="InlineCode"><AppBarButton.Icon><FontIcon Glyph="&#xE943;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Uid="InsertLink" Icon="Link" Label="Insert link" Click="LinkClicked" AutomationProperties.AutomationId="InsertLink"/>
            <AppBarButton x:Uid="AttachFile" Icon="Attach" Label="Attach file" Click="AttachClicked" AutomationProperties.AutomationId="AttachFile"/>
            <AppBarButton x:Uid="NoteDetails" Icon="Document" Label="Note details" IsEnabled="{x:Bind ViewModel.HasSavedNote, Mode=OneWay}" Click="DetailsClicked" AutomationProperties.AutomationId="NoteDetails"/>
            <CommandBar.SecondaryCommands>
              <AppBarButton x:Uid="Save" Icon="Save" Label="Save" Click="SaveClicked" AutomationProperties.AutomationId="Save"/>
              <AppBarButton x:Uid="SaveAsNew" Icon="Copy" Label="Save as new note" Click="SaveAsNewClicked" AutomationProperties.AutomationId="SaveAsNew"/>
              <AppBarButton x:Uid="DiscardDraft" Icon="Undo" Label="Discard local changes" Click="DiscardClicked" AutomationProperties.AutomationId="DiscardDraft"/>
              <AppBarButton x:Uid="DeleteNote" Icon="Delete" Label="Move to Trash" IsEnabled="{x:Bind ViewModel.HasSavedNote, Mode=OneWay}" Click="DeleteNoteClicked" AutomationProperties.AutomationId="DeleteNote"/>
              <AppBarButton x:Uid="ZoomIn" Icon="ZoomIn" Label="Zoom in" Click="ZoomInClicked" AutomationProperties.AutomationId="ZoomIn"/>
              <AppBarButton x:Uid="ZoomOut" Icon="ZoomOut" Label="Zoom out" Click="ZoomOutClicked" AutomationProperties.AutomationId="ZoomOut"/>
              <AppBarButton x:Uid="ZoomReset" Icon="Refresh" Label="Reset zoom" Click="ZoomResetClicked" AutomationProperties.AutomationId="ZoomReset"/>
            </CommandBar.SecondaryCommands>
          </CommandBar>
          <RichEditBox x:Name="Editor" x:Uid="Editor" Grid.Row="1" Margin="24,16" Padding="16" MaxWidth="720" HorizontalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2097152" ClipboardCopyFormat="PlainText" DisabledFormattingAccelerators="All" SelectionFlyout="{x:Null}"
            VerticalContentAlignment="Top" IsEnabled="{x:Bind ViewModel.HasEditor, Mode=OneWay}"
            TextChanging="EditorTextChanging" SelectionChanged="EditorSelectionChanged" TextCompositionStarted="CompositionStarted" TextCompositionEnded="CompositionEnded"
            PreviewKeyDown="EditorPreviewKeyDown" GotFocus="EditorFocusChanged" LostFocus="EditorFocusChanged" ActualThemeChanged="EditorThemeChanged"
            CopyingToClipboard="EditorCopying" CuttingToClipboard="EditorCutting" Paste="EditorPaste"
            AutomationProperties.Name="Live Preview Markdown editor" AutomationProperties.AutomationId="Editor">
            <RichEditBox.ContextFlyout>
              <MenuFlyout Opening="EditorMenuOpening">
                <MenuFlyoutItem x:Name="EditorUndo" x:Uid="EditorUndo" Text="Undo" Click="EditorUndoClicked" AutomationProperties.AutomationId="EditorUndo"/>
                <MenuFlyoutItem x:Name="EditorRedo" x:Uid="EditorRedo" Text="Redo" Click="EditorRedoClicked" AutomationProperties.AutomationId="EditorRedo"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Uid="EditorCut" Text="Cut" Click="EditorCutClicked" AutomationProperties.AutomationId="EditorCut"/>
                <MenuFlyoutItem x:Uid="EditorCopy" Text="Copy" Click="EditorCopyClicked" AutomationProperties.AutomationId="EditorCopy"/>
                <MenuFlyoutItem x:Uid="EditorPaste" Text="Paste" Click="EditorPasteClicked" AutomationProperties.AutomationId="EditorPaste"/>
                <MenuFlyoutItem x:Uid="EditorSelectAll" Text="Select all" Click="EditorSelectAllClicked" AutomationProperties.AutomationId="EditorSelectAll"/>
              </MenuFlyout>
            </RichEditBox.ContextFlyout>
          </RichEditBox>
          <StackPanel x:Name="EmptyEditor" Grid.Row="1" Margin="24" MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock x:Uid="EmptyEditorHeading" Text="Select a note" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Uid="EmptyEditorDescription" Text="Choose a note from the list or create a note." TextWrapping="Wrap"/>
          </StackPanel>
          <TextBlock x:Name="SaveStatus" Grid.Row="2" Margin="24,8" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" AutomationProperties.AutomationId="SaveStatus" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
      </Grid>
    </NavigationView>
    <ContentDialog x:Name="DetailsDialog" x:Uid="DetailsDialog" Title="Note details" CloseButtonText="Close" DefaultButton="Close" AutomationProperties.AutomationId="DetailsDialog">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
          <Expander x:Uid="Links" Header="Links" HorizontalAlignment="Stretch"><ListView x:Name="DetailLinks" MaxHeight="300" IsItemClickEnabled="True" DisplayMemberPath="Text" AutomationProperties.Name="Outgoing links" AutomationProperties.AutomationId="DetailLinks"/></Expander>
          <Expander x:Uid="Backlinks" Header="Backlinks" HorizontalAlignment="Stretch"><ListView x:Name="DetailBacklinks" MaxHeight="300" IsItemClickEnabled="True" DisplayMemberPath="Title" AutomationProperties.Name="Backlinks" AutomationProperties.AutomationId="DetailBacklinks"/></Expander>
          <Expander x:Uid="Attachments" Header="Attachments" HorizontalAlignment="Stretch"><ListView x:Name="DetailAttachments" MaxHeight="300" IsItemClickEnabled="True" DisplayMemberPath="Text" AutomationProperties.Name="Attachments" AutomationProperties.AutomationId="DetailAttachments"/></Expander>
          <Expander x:Uid="History" Header="History" HorizontalAlignment="Stretch"><ListView x:Name="DetailHistory" MaxHeight="300" IsItemClickEnabled="True" DisplayMemberPath="CapturedText" AutomationProperties.Name="Saved versions" AutomationProperties.AutomationId="DetailHistory"/></Expander>
          <ComboBox x:Name="DetailWorkspace" x:Uid="DetailWorkspace" Header="Workspace" DisplayMemberPath="Title" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DetailWorkspace"/>
          <Button x:Name="IncludeWorkspace" x:Uid="IncludeWorkspace" Content="Add to workspace" AutomationProperties.AutomationId="IncludeWorkspace"/>
          <Button x:Name="ExcludeWorkspace" x:Uid="ExcludeWorkspace" Content="Remove from workspace" AutomationProperties.AutomationId="ExcludeWorkspace"/>
        </StackPanel>
      </ScrollViewer>
    </ContentDialog>
  </Grid>
</Page>
